{
  "name": "the-deck",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "test": "DECK_ADMINS=ivan.baranov@t1a.com,varvara.tikhonova@t1a.com,andrii.butko@t1a.com DECK_SYSADMINS=ivan.baranov@t1a.com node --import tsx --test 'server/src/**/*.test.ts' 'client/src/**/*.test.ts' 'shared/**/*.test.ts'",
    "gen": "node --import tsx scripts/gen-map.mjs && node --import tsx scripts/map-atlas.mjs && node scripts/gen-assets.mjs",
    "where": "node --import tsx scripts/where.mjs",
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit",
    "dev:mesh": "DECK_MESH=1 npm run dev",
    "gen:music": "node scripts/gen-music.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  }
}
